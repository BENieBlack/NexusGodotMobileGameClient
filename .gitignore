# Godot 4+ specific ignores
.godot/
/android/
.DS_Store

# テスト・検査の出力とツール用 venv
/reports/
/.make-logs/
/.venv-tools/
__pycache__/

# サードパーティのテスト基盤。tools/install_gdunit4.sh が版を固定して入れる（git には入れない）
/addons/gdUnit4/

# make release-project が作る製品ビルド用の複製
/build/

# 個人名・会社名の拒否リスト（scripts/check-private-info.sh が使う。git に入れない）
/.private-denylist
