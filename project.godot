; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="NexusGodotMobileGameClient"
run/main_scene="res://contexts/auth/presentation/title/title.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

; 順序が大事: EventBus（シグナルの置き場）→ AppContext（依存の組み立て。_ready で他のオートロードを呼ばない）
; → SceneRouter（画面遷移）→ Toast（通知。EventBus を購読する）→ E2EDriver（検証用。--e2e が無ければ何もしない）。
; E2EDriver は debug/ にある開発専用。製品ビルドは `make release-project` が作る複製から、debug/ と一緒にこの行も
; 外す（元のこの project.godot は変えない）。Godot 4.7 は autoload のキーへの機能タグ（debug など）を
; 条件として扱わず常に読み込むため、タグでの切り替えは使えない
EventBus="*res://core/domain/event_bus.gd"
AppContext="*res://app/app_context.gd"
SceneRouter="*res://app/scene_router.gd"
Toast="*res://core/presentation/toast.gd"
E2EDriver="*res://debug/e2e_driver.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-sqlite/plugin.cfg", "res://addons/gdUnit4/plugin.cfg")

[nexus]

; 接続先の既定値（環境変数 NEXUS_API_BASE_URL / NEXUS_MASTER_BASE_URL が優先。ApiConfig を参照）
api_base_url="http://localhost:8090/api"
master_base_url="http://localhost:8091"

; Reverb（WebSocket の通知）の接続先の既定値（環境変数 NEXUS_REVERB_HOST / _PORT / _SCHEME / _APP_KEY が優先）。
; アプリキーの既定値はローカル開発用。製品や他環境では NEXUS_REVERB_APP_KEY かここで上書きする
; スキームは ws か wss。チャンネル認証の URL は api_base_url の origin + /broadcasting/auth（別の設定は無い）
reverb_host="localhost"
reverb_port="8080"
reverb_scheme="ws"
reverb_app_key="nexus-local-key"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
